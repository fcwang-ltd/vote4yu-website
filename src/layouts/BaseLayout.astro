---
import '../styles/globals.css';
import { getContent } from '../utils/content';
import {
  LOCALES,
  LOCALE_HREFLANG,
  LOCALE_HTML_LANG,
  localizePath,
  type Locale,
  isLocale,
} from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  /** Root-relative path without locale prefix, e.g. "/" or "/platform". */
  path?: string;
}
const localeProp = Astro.props.locale ?? 'en';
const locale: Locale = isLocale(localeProp) ? localeProp : 'en';
const t = getContent(locale);
const {
  title = t.meta.siteTitle,
  description = t.meta.siteDescription,
  path = '/',
} = Astro.props;

const SITE_URL = 'https://vote4yu.ca';
const canonical = new URL(localizePath(path, locale), SITE_URL).href;
const htmlLang = LOCALE_HTML_LANG[locale];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Haohui Yu',
  alternateName: '余浩輝',
  jobTitle: 'Candidate for Markham City Council, Ward 2',
  url: SITE_URL,
  knowsLanguage: ['en-CA', 'zh-Hant'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1550 16th Ave, Unit A11',
    addressLocality: 'Richmond Hill',
    addressRegion: 'ON',
    postalCode: 'L4B 3K9',
    addressCountry: 'CA',
  },
  email: 'hello@vote4yu.ca',
};
---

<!doctype html>
<html lang={htmlLang} class={locale === 'zh-HK' ? 'lang-zh' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={LOCALE_HREFLANG[l]}
          href={new URL(localizePath(path, l), SITE_URL).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, 'en'), SITE_URL).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    {
      locale === 'zh-HK' && t.common.draftBanner && (
        <div class="draft-banner" role="status">{t.common.draftBanner}</div>
      )
    }
    <slot />
  </body>
</html>

<style>
  .draft-banner {
    background: var(--color-pink-100);
    color: var(--color-pink-700);
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
  }
</style>
