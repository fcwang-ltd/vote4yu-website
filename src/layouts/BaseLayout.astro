---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
}
const {
  title = 'Accélérateur technologique à Québec | LE CAMP',
  description = 'Nous soutenons les entreprises innovantes à chaque étape de leur croissance.',
  locale = 'fr',
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
