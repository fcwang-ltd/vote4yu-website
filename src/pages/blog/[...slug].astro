---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { NAV } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.data.locale === 'en');
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^en\//, '') },
    props: { post },
  }));
}
const locale = 'en' as const;
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} — Vote4Yu`} description={post.data.description} locale={locale} path={`/blog/${post.slug.replace(/^en\//, '')}`}>
  <Nav locale={locale} path="/blog" navLabels={NAV[locale]} />
  <main class="container-1200" style="padding-block: 60px; max-width: 720px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(28px,5vw,44px); font-weight:800; line-height:1.15;">{post.data.title}</h1>
    <p style="color: var(--color-muted); font-family: var(--font-mono); font-size: 12px; margin: 0.5rem 0 2rem;">
      {post.data.pubDate.toISOString().slice(0, 10)} &middot; {post.data.author}
    </p>
    <article style="line-height: 1.8;"><Content /></article>
  </main>
  <Footer locale={locale} />
</BaseLayout>
