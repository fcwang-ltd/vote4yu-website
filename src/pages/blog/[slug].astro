---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/lecamp/Nav.astro';
import Footer from '../../components/lecamp/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.locale === 'en' && !data.draft);
  return posts.map((post) => {
    const slug = post.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? post.id;
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | VOTE4YU`} description={post.data.description}>
  <Nav />
  <article class="post container-1200">
    <p class="label-mono">BLOG AND MEDIA</p>
    <h1 class="post__title">{post.data.title}</h1>
    <p class="post__meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </p>
    {
      post.data.heroImage && (
        <img class="post__hero" src={post.data.heroImage.src} alt={post.data.heroImage.alt} />
      )
    }
    <div class="post__body">
      <Content />
    </div>
    <p class="post__back">
      <a href="/blog">← Blog and Media</a>
    </p>
  </article>
  <Footer />
</BaseLayout>

<style>
  .post {
    padding-block: 96px;
  }
  .post__title {
    font-family: var(--font-agrandir);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    margin: 0.5rem 0 0.75rem;
    max-width: 18ch;
  }
  .post__meta {
    font-family: var(--font-dm-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--color-ridge-gray);
    margin: 0 0 2rem;
  }
  .post__hero {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--radius-cards);
    margin-bottom: 2rem;
  }
  .post__body {
    max-width: 62ch;
    font-family: var(--font-dm-sans);
    font-size: 16px;
    line-height: 1.55;
  }
  .post__body :global(h2) {
    font-family: var(--font-agrandir);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
  }
  .post__body :global(p) {
    margin: 0 0 1rem;
  }
  .post__body :global(strong) {
    font-weight: 700;
  }
  .post__body :global(a) {
    color: var(--color-signal-red);
  }
  .post__back {
    margin-top: 3rem;
    font-family: var(--font-dm-sans);
  }
  .post__back a {
    color: #000;
    text-decoration: none;
  }
</style>
