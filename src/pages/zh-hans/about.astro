---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import { NAV, PAGE_TITLES } from '../../utils/content';
const locale = 'zh-Hans' as const;
---

<BaseLayout title={PAGE_TITLES[locale].about} description="Dave Yu 拥有十余年社区健康与健身实践经验。[DRAFT]" locale={locale} path="/about">
  <Nav locale={locale} path="/about" navLabels={NAV[locale]} />
  <main class="container-1200" style="padding-block: 60px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(32px,6vw,56px); font-weight:800;">关于 Dave Yu</h1>
    <p style="max-width: 60ch; line-height: 1.7; margin-top: 1rem;">DRAFT — 待母语审校。Dave Yu 是 2026 万锦市选举 2 区市议员候选人。</p>
  </main>
  <Footer locale={locale} boilerplate="[DRAFT]" />
</BaseLayout>
