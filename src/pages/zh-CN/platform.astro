---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import HealthPillarBadge from '../../components/ui/HealthPillarBadge.astro';
import { NAV, HEALTH_PILLARS, PAGE_TITLES } from '../../utils/content';
const locale = 'zh-CN' as const;
---

<BaseLayout title={PAGE_TITLES[locale].platform} description="健康政纲：住房、教育、医疗可及、生活品质、科技、热情服务。[DRAFT]" locale={locale} path="/platform">
  <Nav locale={locale} path="/platform" navLabels={NAV[locale]} />
  <main class="container-1200" style="padding-block: 60px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(32px,6vw,56px); font-weight:800; line-height:1.1;">创建健康万锦</h1>
    <p style="max-width: 60ch; line-height: 1.7; margin-top: 1rem;">DRAFT — 全部中文文案待母语（普通话与粤语）审校后定稿。</p>
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-top: 2rem;">
      {HEALTH_PILLARS.map((p) => <HealthPillarBadge letter={p.letter} pillar={p.pillar} message={p.message} anchor={p.anchor} />)}
    </div>
  </main>
  <Footer locale={locale} boilerplate="[DRAFT]" />
</BaseLayout>
