---
import PageShell from '../components/campaign/PageShell.astro';
import PageHero from '../components/campaign/PageHero.astro';
import CtaArrow from '../components/ui/CtaArrow.astro';
import { getContent, HEALTH_PLANKS, plankBody } from '../utils/content';
import { localizePath } from '../utils/i18n';

const locale = 'en' as const;
const t = getContent(locale);
---

<PageShell locale={locale} path="/platform" active="platform" title={`${t.platform.title}: Vote 4 Yu`}>
  <PageHero badge={t.platform.badge} title={t.platform.title} intro={t.platform.body}>
    <Fragment slot="actions">
      <a class="btn btn--pink" href={localizePath('/platform/talk', locale)}
        >{t.common.talkToYu} <CtaArrow /></a
      >
      <a class="btn btn--outline-pink" href={localizePath('/platform/progress', locale)}
        >{t.common.trackProgress}</a
      >
    </Fragment>
  </PageHero>
  <section class="section-pad">
    <div class="container-1200 plank-list">
      {
        HEALTH_PLANKS.map((plank) => (
          <article class="plank">
            <h2>
              <span class="plank__letter">{plank.letter}<span class="plank__dot">.</span></span>
              <span class="plank__zh">{plank.labelZh}</span>
              <span class="plank__en">{plank.labelEn}</span>
            </h2>
            <p>{plankBody(plank, locale)}</p>
            <a href={localizePath('/platform/progress', locale)}>{t.platform.seeProgress}</a>
          </article>
        ))
      }
    </div>
  </section>
</PageShell>

<style>
  .plank-list {
    display: grid;
    gap: 1.25rem;
    max-width: 48rem;
  }
  .plank {
    background: var(--color-paper);
    color: var(--color-ink-900);
    padding: 1.25rem 0;
    border-top: 3px solid var(--color-pink-500);
  }
  .plank h2 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.05rem;
    margin: 0 0 0.5rem;
    font-size: inherit;
  }
  .plank__letter {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.65rem;
    color: var(--color-blue-600);
    line-height: 1;
    margin-right: 0.4rem;
  }
  .plank__dot {
    color: var(--color-pink-500);
  }
  .plank__zh {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink-900);
    margin-right: 0.4rem;
  }
  .plank__en {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--color-ink-900);
  }
  .plank p {
    margin: 0 0 0.85rem;
    color: var(--color-ink-600);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .plank a {
    color: var(--color-pink-500);
    font-weight: 700;
    text-decoration: none;
  }
</style>
