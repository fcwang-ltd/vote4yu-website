---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/lecamp/Nav.astro';
import Footer from '../components/lecamp/Footer.astro';

const pillars = [
  {
    letter: 'H',
    name: 'Housing',
    anchor: false,
    body: 'Responsible development that grows housing options while keeping the character of our neighbourhoods. Showing up for planning and zoning decisions with residents at the table, not after the fact.',
  },
  {
    letter: 'E',
    name: 'Education',
    anchor: false,
    body: 'Lifelong learning and clear health information, so families can navigate services across languages and generations. Supporting youth programming and school-community safety.',
  },
  {
    letter: 'A',
    name: 'Accessibility',
    anchor: true,
    body: 'Shorter waits to find a family doctor, barrier-free services, and real help navigating the health system in the language you speak at home. This is where my experience runs deepest.',
  },
  {
    letter: 'L',
    name: 'Living quality',
    anchor: true,
    body: 'Safe, clean, well-kept neighbourhoods. The everyday municipal work that makes a street feel cared for: lighting, parks, recreation, and seniors\u2019 safety.',
  },
  {
    letter: 'T',
    name: 'Technology',
    anchor: false,
    body: 'Practical digital tools that connect residents to information and to each other, without leaving anyone behind. Markham calls itself Canada\u2019s High-Tech Capital; local services should feel that way too.',
  },
  {
    letter: 'H',
    name: 'Hospitality',
    anchor: false,
    body: 'A councillor who shows up. Regular community office hours, service in three languages, and a door that stays open to every resident, newcomer and long-time neighbour alike.',
  },
];
---

<BaseLayout
  title="Platform — Creating a HEALTH-y Markham | VOTE4YU"
  description="The HEALTH platform for Markham Ward 2: Housing, Education, Accessibility, Living quality, Technology, and Hospitality, anchored on preventive health and access to care."
  path="/platform"
>
  <Nav />
  <main class="container-1200 platform">
    <p class="label-mono">THE PLATFORM</p>
    <h1 class="platform__title">Creating a HEALTH-y Markham</h1>
    <p class="platform__lede">
      Health is the anchor of everything I will work on. The six letters set the breadth of the platform, and
      Accessibility and Living quality carry the heart of it: preventive care, access to a family doctor, and
      neighbourhoods that feel cared for.
    </p>

    <div class="platform__grid">
      {
        pillars.map((p) => (
          <article class:list={['pillar', p.anchor && 'pillar--anchor']}>
            <span class="pillar__letter">{p.letter}</span>
            <h2 class="pillar__name">
              {p.name}
              {p.anchor && <span class="pillar__tag">Anchor</span>}
            </h2>
            <p class="pillar__body">{p.body}</p>
          </article>
        ))
      }
    </div>

    <section class="platform__note">
      <h2>What a councillor can, and cannot, do</h2>
      <p>
        Many health programs are run by the provincial and federal governments, not the city. A councillor's real power
        is to advocate, to help residents understand and reach the programs that already exist, and to connect
        community needs with the right services. I will be honest about that line. This platform is about the work a
        Ward 2 councillor can genuinely do, and where I will push higher levels of government to do more.
      </p>
    </section>

    <div class="platform__cta">
      <a class="btn-rect btn-rect--ink" href="/about">About Dave</a>
      <a class="btn-rect btn-rect--red" href="/get-involved">Get involved</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .platform {
    padding-block: 96px;
  }
  .platform__title {
    font-family: var(--font-agrandir);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    margin: 0.5rem 0 1rem;
    max-width: 16ch;
  }
  .platform__lede {
    max-width: 62ch;
    font-size: 18px;
    line-height: 1.55;
    margin: 0 0 2.5rem;
  }
  .platform__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .pillar {
    border: 1px solid rgb(0 0 0 / 0.15);
    border-radius: var(--radius-cards);
    padding: 1.75rem;
    background: #fff;
  }
  .pillar--anchor {
    border-color: var(--color-signal-red);
    box-shadow: 0 0 0 1px var(--color-signal-red);
  }
  .pillar__letter {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    border: 2px solid var(--color-signal-red);
    color: var(--color-signal-red);
    font-family: var(--font-agrandir);
    font-weight: 800;
    font-size: 20px;
  }
  .pillar__name {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: 1.5rem;
    margin: 0.85rem 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pillar__tag {
    font-family: var(--font-dm-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-signal-red);
    border-radius: 4px;
    padding: 3px 6px;
  }
  .pillar__body {
    margin: 0;
    line-height: 1.55;
    font-size: 15px;
  }
  .platform__note {
    margin-top: 3rem;
    background: var(--surface-trail-cream);
    border-radius: var(--radius-cards);
    padding: 2rem;
    max-width: 72ch;
  }
  .platform__note h2 {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }
  .platform__note p {
    margin: 0;
    line-height: 1.6;
  }
  .platform__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
</style>
