---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import HealthPillarBadge from '../components/ui/HealthPillarBadge.astro';
import { NAV, HEALTH_PILLARS, PAGE_TITLES } from '../utils/content';
const locale = 'en' as const;
---

<BaseLayout
  title={PAGE_TITLES[locale].platform}
  description="The HEALTH platform: Housing, Education, Accessibility, Living quality, Technology, and Hospitality, anchored on preventive health and eldercare access for Markham Ward 2."
  locale={locale}
  path="/platform"
>
  <Nav locale={locale} path="/platform" navLabels={NAV[locale]} />
  <main class="container-1200" style="padding-block: 60px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(32px,6vw,56px); font-weight:800; line-height:1.1;">
      Creating a HEALTH-y Markham
    </h1>
    <p style="max-width: 60ch; line-height: 1.7; margin-top: 1rem;">
      Health is the anchor. The six letters set the breadth. Accessibility and Living quality carry the preventive-health and eldercare spearhead.
    </p>
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-top: 2rem;">
      {HEALTH_PILLARS.map((p) => <HealthPillarBadge letter={p.letter} pillar={p.pillar} message={p.message} anchor={p.anchor} />)}
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
