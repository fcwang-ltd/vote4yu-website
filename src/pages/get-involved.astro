---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/lecamp/Nav.astro';
import Footer from '../components/lecamp/Footer.astro';
---

<BaseLayout title="Get Involved | VOTE4YU">
  <Nav />
  <main class="container-1200" style="padding-block:96px;">
    <p class="label-mono">GET INVOLVED</p>
    <h1 style="font-family:var(--font-agrandir);font-size:clamp(40px,6vw,64px);font-weight:600;line-height:1;margin:0.5rem 0 1rem;">
      Get Involved
    </h1>
    <p style="max-width:42ch;line-height:1.5;">
      Volunteer, host, donate, and share the campaign. Full involvement pathways coming soon.
    </p>
  </main>
  <Footer />
</BaseLayout>
