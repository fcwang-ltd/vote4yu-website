---
/*
 * UNLISTED, PASSWORD-GATED PAGE.
 *
 * Deliberately bare: renders through BaseLayout rather than PageShell, so it
 * has no nav, no ticker and no footer.
 *
 * Content comes from private/page.html, which is gitignored and must stay that
 * way — this repository is PUBLIC. The build encrypts that file with
 * PRIVATE_PAGE_PASSPHRASE and emits only the ciphertext, so the deployed page
 * is unreadable without the passphrase.
 *
 * Never commit the plaintext or the passphrase. Anything committed here is
 * readable on github.com and stays in git history after deletion.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/ui/Wordmark.astro';
import { lockContent } from '../utils/lockedContent';

const locale = 'en' as const;
const PATH = '/private-62e6aed4888d372bb76bcb97';

const locked = await lockContent('private/page.html');
---

<BaseLayout
  locale={locale}
  path={PATH}
  title="Protected page"
  description="Password protected."
  noindex
>
  <main class="gate" data-gate-root>
    <div class="gate__inner" data-gate>
      <div class="gate__brand">
        <Wordmark locale={locale} />
      </div>

      <form class="gate__form" data-unlock-form>
        <label class="gate__label" for="gate-pass">Password</label>
        <input
          class="gate__input"
          id="gate-pass"
          type="password"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          required
        />
        <button class="btn btn--pink gate__btn" type="submit" data-unlock-submit>
          Unlock
        </button>

        <p class="gate__msg" role="alert" hidden data-unlock-error>
          That password did not work.
        </p>
        {
          !locked && (
            <p class="gate__msg gate__msg--quiet">There is no content published yet.</p>
          )
        }
      </form>

      {
        locked && (
          <script
            type="application/json"
            data-unlock-payload
            set:html={JSON.stringify(locked)}
          />
        )
      }
    </div>

    <div class="gate__content" data-unlock-content hidden></div>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.querySelector('[data-unlock-form]');
    if (!form) return;

    var payloadEl = document.querySelector('[data-unlock-payload]');
    var input = document.getElementById('gate-pass');
    var errorEl = document.querySelector('[data-unlock-error]');
    var target = document.querySelector('[data-unlock-content]');
    var gate = document.querySelector('[data-gate]');
    var root = document.querySelector('[data-gate-root]');
    var submit = document.querySelector('[data-unlock-submit]');

    function bytes(b64) {
      var bin = atob(b64);
      var out = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
      return out;
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorEl.hidden = true;

      /* Nothing was built into the page, so there is nothing to unlock. */
      if (!payloadEl) {
        errorEl.hidden = false;
        return;
      }

      var payload = JSON.parse(payloadEl.textContent);
      submit.disabled = true;
      /* The key derivation is deliberately slow; say so rather than look hung. */
      var label = submit.textContent;
      submit.textContent = 'Unlocking…';

      try {
        var baseKey = await crypto.subtle.importKey(
          'raw',
          new TextEncoder().encode(input.value),
          'PBKDF2',
          false,
          ['deriveKey']
        );
        var key = await crypto.subtle.deriveKey(
          {
            name: 'PBKDF2',
            salt: bytes(payload.salt),
            iterations: payload.iterations,
            hash: 'SHA-256',
          },
          baseKey,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt']
        );
        var plain = await crypto.subtle.decrypt(
          { name: 'AES-GCM', iv: bytes(payload.iv) },
          key,
          bytes(payload.ciphertext)
        );

        target.innerHTML = new TextDecoder().decode(plain);
        target.hidden = false;
        gate.hidden = true;
        /* Stop centring, or content taller than the viewport overflows upward
           and cannot be scrolled back to. */
        root.classList.add('is-unlocked');
      } catch (err) {
        /* AES-GCM fails authentication on a wrong password. */
        errorEl.hidden = false;
        input.value = '';
        input.focus();
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  })();
</script>

<style>
  .gate {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem;
  }
  .gate.is-unlocked {
    min-height: 0;
    justify-content: flex-start;
    padding: 0;
  }
  .gate__inner {
    width: 100%;
    max-width: 20rem;
  }
  .gate__brand {
    margin-bottom: 1.75rem;
  }
  .gate__form {
    display: flex;
    flex-direction: column;
  }
  .gate__label {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }
  .gate__input {
    padding: 0.65rem 0.75rem;
    font: inherit;
    border: 1px solid var(--color-taupe-200);
    background: var(--color-paper);
  }
  .gate__btn {
    margin-top: 0.75rem;
    justify-content: center;
  }
  .gate__msg {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-pink-500);
  }
  .gate__msg--quiet {
    font-weight: 400;
    color: var(--color-ink-500);
  }
  /* Once unlocked the content takes the page, still with no nav or footer. */
  .gate__content {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 3rem 1.25rem;
    line-height: 1.55;
  }
</style>
