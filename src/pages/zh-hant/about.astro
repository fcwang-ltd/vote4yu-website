---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import { NAV, PAGE_TITLES } from '../../utils/content';
const locale = 'zh-Hant' as const;
---

<BaseLayout title={PAGE_TITLES[locale].about} description="Dave Yu 擁有十餘年社區健康與健身實踐經驗。[DRAFT]" locale={locale} path="/about">
  <Nav locale={locale} path="/about" navLabels={NAV[locale]} />
  <main class="container-1200" style="padding-block: 60px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(32px,6vw,56px); font-weight:800;">關於 Dave Yu</h1>
    <p style="max-width: 60ch; line-height: 1.7; margin-top: 1rem;">DRAFT — 待母語審校。Dave Yu 是 2026 萬錦市選舉 2 區市議員候選人。</p>
  </main>
  <Footer locale={locale} boilerplate="[DRAFT]" />
</BaseLayout>
