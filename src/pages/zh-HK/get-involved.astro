---
import PageShell from '../../components/campaign/PageShell.astro';
import PageHero from '../../components/campaign/PageHero.astro';
import CtaArrow from '../../components/ui/CtaArrow.astro';
import { getContent } from '../../utils/content';
import { localizePath } from '../../utils/i18n';

const locale = 'zh-HK' as const;
const t = getContent(locale);

const cards = [
  {
    title: t.involved.donateTitle,
    body: t.involved.donateBody,
    cta: t.involved.donateCta,
    href: '/donate',
    critical: true,
  },
  {
    title: t.involved.partnerTitle,
    body: t.involved.partnerBody,
    cta: t.involved.partnerCta,
    href: 'mailto:amanda@vote4yu.ca',
    external: true,
    critical: false,
  },
  {
    title: t.involved.volTitle,
    body: t.involved.volBody,
    cta: t.involved.volCta,
    href: '/get-involved/volunteer',
    critical: false,
  },
  {
    title: t.involved.mediaTitle,
    body: t.involved.mediaBody,
    cta: t.involved.mediaCta,
    href: '/interview',
    critical: false,
  },
];
---

<PageShell
  locale={locale}
  path="/get-involved"
  active="involved"
  title={`${t.involved.title}: Vote 4 Yu`}
>
  <PageHero badge={t.involved.badge} title={t.involved.title} intro={t.involved.body} />
  <section class="section-pad">
    <div class="container-1200 involve-grid">
      {
        cards.map((card) => (
          <article class="involve-card">
            <h2>{card.title}</h2>
            <p>{card.body}</p>
            <a
              class:list={['btn', card.critical ? 'btn--pink' : 'btn--outline-pink']}
              href={card.external ? card.href : localizePath(card.href, locale)}
            >
              {card.cta}
              {card.critical && <CtaArrow />}
            </a>
          </article>
        ))
      }
    </div>
    <div class="container-1200" style="margin-top:2rem">
      <img
        src="/images/candidate/yu-photo-blue.png"
        alt="Haohui Yu"
        width="720"
        height="800"
        style="max-width:320px;width:100%;height:auto"
      />
    </div>
  </section>
</PageShell>

<style>
  .involve-grid {
    display: grid;
    gap: 1.25rem;
  }
  .involve-card {
    border-top: 3px solid var(--color-pink-500);
    padding: 1.25rem 0;
  }
  .involve-card h2 {
    margin: 0 0 0.5rem;
  }
  .involve-card p {
    margin: 0 0 1rem;
    color: var(--color-ink-600);
  }
  @media (min-width: 800px) {
    .involve-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
</style>
