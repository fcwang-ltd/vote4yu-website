---
import PageShell from '../components/campaign/PageShell.astro';
import PageHero from '../components/campaign/PageHero.astro';

const locale = 'en' as const;

const partners = [
  { name: 'Dr. Jerry Leung Medical Club', href: 'https://www.drjerryleung.ca/' },
  { name: 'Up&Fit Fitness', href: 'https://www.upandfit.ca/' },
];
---

<PageShell locale={locale} path="/community" active="about" title="Community partners: Vote 4 Yu">
  <PageHero
    badge="Community"
    title="Health community partners"
    intro="Haohui Yu works within Markham's health community every week. These organisations are part of that network."
  />
  <section class="section-pad">
    <div class="container-1200">
      <ul style="list-style:none;padding:0;display:grid;gap:1rem;max-width:36rem">
        {
          partners.map((p) => (
            <li style="border-top:3px solid var(--color-pink-500);padding-top:0.75rem">
              <a href={p.href} rel="noopener noreferrer" target="_blank" style="font-weight:700;color:var(--color-blue-600)">
                {p.name} →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</PageShell>
