---
/**
 * VOTE4YU homepage — Dave Yu, Markham Ward 2, 2026.
 * Layout adapted from the LE CAMP reference; all copy is campaign content.
 * Photos: candidate + atmosphere placeholders (real shoot pending).
 */
import Nav from './Nav.astro';
import HealthStickers from './HealthStickers.astro';
import HealthCascade from './HealthCascade.astro';

// Local health-community organisations Dave works within (real, linkable).
// Framed as network context, not endorsements.
const network = [
  { name: 'Dr. Jerry Leung Medical Club', href: 'https://www.drjerryleung.ca/' },
  { name: 'Up&Fit Fitness', href: 'https://www.upandfit.ca/' },
];
---

<div class="home">
  {/* Le Camp: fullscreen at rest → inset rounded float on scroll */}
  <div class="hero-pin" data-hero-pin>
    <div class="hero-sticky">
      <section class="hero" data-hero>
        <Nav onDark />
        <HealthStickers />
        <div class="hero__inner">
          <h1>For your family's health, your street, your Markham.</h1>
        </div>
        <div class="hero__foot">
          <span>MARKHAM · WARD 2</span>
          <a class="hero__scroll" href="#health" aria-label="Scroll">↓</a>
          <span>MUNICIPAL ELECTION 2026</span>
        </div>
      </section>
    </div>
  </div>

  <HealthCascade />

  <section id="intro" class="container-1200 section section--after-health">
    <div class="intro">
      <div class="intro__copy">
        <p>
          For ten years I have helped Markham families get healthier, one person at a time. My team and I have trained
          more than 6,000 residents, and I have worked alongside local doctors, clinics, and community health providers.
          I am running for Ward 2 council to bring that same practical, close-to-the-ground care to the decisions that
          shape our neighbourhood.
        </p>
        <a class="btn-rect btn-rect--ink" href="/about">About Dave</a>
      </div>
      <h2 class="intro__display">
        <span>A decade</span>
        <span>serving</span>
        <span>Markham</span>
      </h2>
    </div>
    <div class="photos">
      <img class="photos__a" src="/images/candidate/pagent-coach.jpeg" alt="" />
      <img class="photos__b" src="/images/candidate/health-interview.jpeg" alt="" />
      <div class="photos__c-wrap">
        <img class="photos__c" src="/images/candidate/stage-front.jpeg" alt="" />
        <img class="photos__badge" src="/images/stickers/sticker-tent-blue.png" alt="" aria-hidden="true" />
      </div>
    </div>
  </section>

  <section class="container-1200 section section--tight">
    <div class="programs-head">
      <h2>How I will serve Ward 2</h2>
      <div class="programs-head__aside">
        <p>
          Health is the through-line of local decisions: how we reach care, how safe our streets feel, and how present
          our councillor is. These are the areas I will push on first.
        </p>
        <a class="btn-pill btn-pill--ink" href="/platform">See the full platform</a>
      </div>
    </div>

    <div class="bento">
      <article class="card card--ink a">
        <h3>Accessibility</h3>
        <p>
          Shorter waits to find a family doctor, barrier-free services, and clear help navigating the health system in
          the language you speak at home.
        </p>
        <span class="arrow" aria-hidden="true">→</span>
      </article>
      <img class="img b" src="/images/atmosphere/PLACEHOLDER-AI-canopy-light.png" alt="" />

      <article class="card card--sky c">
        <h3>Living quality</h3>
        <p>
          Safe, clean, well-kept neighbourhoods. The everyday municipal work that makes a street feel cared for, from
          lighting and parks to seniors' safety.
        </p>
        <span class="arrow" aria-hidden="true">→</span>
      </article>
      <img class="img d" src="/images/atmosphere/PLACEHOLDER-AI-fern-light.png" alt="" />

      <img class="img e" src="/images/atmosphere/PLACEHOLDER-AI-path-walk.png" alt="" />
      <article class="card card--cream f">
        <h3>Hospitality</h3>
        <p>
          A councillor who shows up. Regular community office hours, service in three languages, and a door that stays
          open to every resident.
        </p>
        <span class="arrow arrow--red" aria-hidden="true">→</span>
      </article>
    </div>
  </section>

  <section class="container-1200 section proof">
    <p class="label-mono">MARKHAM HEALTH COMMUNITY</p>
    <h2>Rooted in Markham's health community</h2>
    <div class="proof__row proof__row--orgs" aria-label="Local health-community organisations">
      {
        network.map((org) => (
          <a class="org" href={org.href} target="_blank" rel="noopener noreferrer">
            {org.name}
          </a>
        ))
      }
    </div>
  </section>

  <section class="container-1200 section">
    <div class="guides">
      <div class="guides__body">
        <p class="label-mono guides__label">HEALTH IS THE THROUGH-LINE</p>
        <h2>A decade of health, brought to the council table</h2>
        <p>
          I hold a health-science degree and have spent my career in community and personal health, working with
          doctors, clinics, and thousands of Markham residents. That experience is exactly what Ward 2 needs on
          council: someone who understands how people actually reach care, and who will advocate for it.
        </p>
        <a class="btn-rect btn-rect--red" href="/about">Read Dave's story</a>
      </div>
      <div class="guides__media">
        <img src="/images/candidate/stage-front.jpeg" alt="" />
        <img class="guides__badge" src="/images/stickers/sticker-tent-coral.png" alt="" aria-hidden="true" />
      </div>
    </div>
  </section>

  <section class="container-1200 section">
    <div class="events">
      <div class="events__copy">
        <p class="label-mono">IN THE COMMUNITY</p>
        <h2>Where to find me</h2>
        <p>
          The best way to know a candidate is to meet them. I am out in Ward 2 regularly. Come say hello, and tell me
          what matters on your street.
        </p>
        <a class="btn-pill btn-pill--ink" href="/events">All community events</a>
      </div>
      <div class="events__cards">
        <a class="event event--low" href="/events">
          <div class="event__media">
            <img src="/images/atmosphere/PLACEHOLDER-AI-markham-atmosphere.png" alt="" />
            <div class="chips">
              <span class="chip">IN PERSON</span>
              <span class="chip">SENIORS</span>
            </div>
          </div>
          <div class="event__foot event__foot--red">
            <p class="meta">DATE TO BE CONFIRMED</p>
            <h3>Ward 2 Seniors Health Info Session</h3>
            <span class="arrow" aria-hidden="true">→</span>
          </div>
        </a>
        <a class="event event--high" href="/events">
          <div class="event__media">
            <img src="/images/candidate/pagent-coach.jpeg" alt="" />
            <div class="chips">
              <span class="chip">IN PERSON</span>
              <span class="chip">COMMUNITY</span>
            </div>
          </div>
          <div class="event__foot event__foot--burgundy">
            <p class="meta">DATE TO BE CONFIRMED</p>
            <h3>Community Walk and Talk</h3>
            <span class="arrow" aria-hidden="true">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="container-1200 section section--journal">
    <div class="journal">
      <p class="label-mono">UPDATES</p>
      <h2>From the campaign</h2>
      <a class="journal__row" href="/blog/building-a-healthier-markham">
        <span class="journal__title">Building a HEALTHier Markham: the six-pillar platform</span>
        <span class="journal__badge">ARTICLE</span>
        <span class="journal__date">11 AUG 2026</span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="journal__row" href="/blog/family-doctor-wait">
        <span class="journal__title">The family-doctor wait is a Ward 2 problem</span>
        <span class="journal__badge">ARTICLE</span>
        <span class="journal__date">12 AUG 2026</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</div>

<style>
  .home {
    background: #fff;
    color: #000;
    font-family: var(--font-dm-sans);
  }
  .section { padding-block: 60px; }
  .section--tight { padding-top: 24px; }
  .section--after-health { padding-top: 48px; }
  .section--journal { padding-top: 24px; padding-bottom: 40px; }

  /* Hero pin: creates scroll room so sticky frame can inset */
  .hero-pin {
    height: 140svh;
    background: #fff;
  }
  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    z-index: 5;
    padding: calc(var(--hero-inset, 0) * 20px);
    box-sizing: border-box;
    transition: padding 0.05s linear;
  }
  .hero {
    --hero-radius: calc(var(--hero-inset, 0) * 40px);
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #fff;
    background:
      linear-gradient(rgb(8 12 22 / 0.55), rgb(8 12 22 / 0.72)),
      url('/images/atmosphere/PLACEHOLDER-AI-hero-interview-contour.png') center / cover no-repeat;
    overflow: hidden;
    border-radius: var(--hero-radius);
    will-change: border-radius;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 140px 1.5rem 120px;
    max-width: 920px;
  }
  .hero h1 {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: clamp(40px, 6.5vw, 72px);
    line-height: 1;
    letter-spacing: -0.01em;
    max-width: 16ch;
    margin: 0 auto;
    text-shadow: none;
  }
  .hero__foot {
    position: absolute;
    left: 0; right: 0; bottom: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: clamp(1.5rem, 4vw, 3rem);
    font-family: var(--font-dm-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    z-index: 2;
  }
  .hero__scroll {
    width: 40px; height: 40px;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.55);
    display: grid; place-items: center;
    color: #fff; text-decoration: none;
  }

  .intro {
    display: grid;
    grid-template-columns: 0.85fr 1.35fr;
    gap: 2.5rem;
    align-items: start;
  }
  .intro__copy p {
    font-size: 14px;
    line-height: 1.45;
    max-width: 42ch;
    margin: 0 0 1.5rem;
  }
  .intro__display {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: clamp(44px, 7vw, 90px);
    line-height: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .photos {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin-top: 3rem;
  }
  .photos img {
    object-fit: cover;
    border-radius: 28px;
    display: block;
  }
  .photos__a { flex: 1.05; height: 280px; width: 100%; }
  .photos__b { flex: 0.95; height: 380px; width: 100%; }
  .photos__c-wrap { position: relative; flex: 1.15; }
  .photos__c { width: 100%; height: 520px; }
  .photos__badge {
    position: absolute;
    top: -16px; right: -10px;
    width: 56px; height: auto;
  }

  .programs-head {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .programs-head h2 {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.08;
    margin: 0;
    max-width: 18ch;
  }
  .programs-head__aside {
    text-align: right;
    justify-self: end;
    max-width: 36ch;
  }
  .programs-head__aside p {
    margin: 0 0 1.25rem;
    font-size: 14px;
    line-height: 1.45;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.25rem;
  }
  .card {
    border-radius: 28px;
    padding: 2rem 2rem 2.5rem;
    position: relative;
    min-height: 220px;
  }
  .card h3 {
    font-family: var(--font-agrandir);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    margin: 0 0 0.85rem;
  }
  .card p {
    margin: 0;
    line-height: 1.45;
    font-size: 14px;
    max-width: 36ch;
  }
  .card--ink { background: #000; color: #fff; }
  .card--ink h3 { color: var(--color-sky); }
  .card--sky { background: var(--color-sky); color: #000; }
  .card--cream { background: var(--surface-trail-cream); color: var(--color-signal-red); }
  .arrow {
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    font-size: 1.25rem;
  }
  .arrow--red { color: var(--color-signal-red); }
  .img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 28px;
    display: block;
  }
  .a { grid-column: 1 / 6; grid-row: 1; }
  .b { grid-column: 6 / 13; grid-row: 1; min-height: 320px; }
  .c { grid-column: 1 / 6; grid-row: 2; }
  .d { grid-column: 6 / 13; grid-row: 2; min-height: 280px; }
  .e { grid-column: 1 / 8; grid-row: 3; min-height: 300px; transform: rotate(-1.25deg); }
  .f { grid-column: 8 / 13; grid-row: 3; }

  .proof { text-align: center; }
  .proof .label-mono { margin: 0 0 0.75rem; }
  .proof h2 {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: clamp(28px, 4vw, 42px);
    margin: 0 auto 2rem;
    max-width: 22ch;
    line-height: 1.1;
  }
  .proof__row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
    align-items: center;
  }
  .proof__row img {
    width: 100%;
    max-height: 44px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.85;
  }
  .proof__row--orgs {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    max-width: 720px;
    margin-inline: auto;
  }
  .org {
    display: grid;
    place-items: center;
    text-align: center;
    border: 1px solid rgb(0 0 0 / 0.15);
    border-radius: 16px;
    padding: 1.5rem 1.25rem;
    min-height: 88px;
    text-decoration: none;
    color: #000;
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.2;
    transition: border-color 0.2s ease;
  }
  .org:hover {
    border-color: var(--color-signal-red);
    color: var(--color-signal-red);
  }

  .guides {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    background: var(--surface-trail-cream);
    border-radius: 40px;
    padding: 2.5rem 0 2.5rem 2.5rem;
    align-items: center;
  }
  .guides__body { padding-right: 2rem; color: var(--color-signal-red); }
  .guides__label { color: var(--color-signal-red); margin: 0 0 0.75rem; }
  .guides__body h2 {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: clamp(32px, 4vw, 44px);
    margin: 0 0 1rem;
    line-height: 1.1;
  }
  .guides__body p {
    margin: 0 0 1.5rem;
    line-height: 1.55;
    max-width: 38ch;
    font-size: 16px;
  }
  .guides__media {
    position: relative;
    margin-block: -48px;
    margin-right: 1.5rem;
  }
  .guides__media > img:first-child {
    width: 100%;
    min-height: 420px;
    object-fit: cover;
    border-radius: 28px;
    display: block;
  }
  .guides__badge {
    position: absolute;
    left: -12px;
    bottom: 24px;
    width: 64px;
    height: auto;
  }

  .events {
    display: grid;
    grid-template-columns: 0.85fr 1.35fr;
    gap: 2.5rem;
  }
  .events__copy .label-mono { margin: 0 0 0.5rem; }
  .events__copy h2 {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: clamp(36px, 5vw, 52px);
    margin: 0 0 1rem;
    line-height: 1.05;
  }
  .events__copy p {
    margin: 0 0 1.5rem;
    line-height: 1.5;
    max-width: 36ch;
    font-size: 14px;
  }
  .events__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .event {
    border-radius: 28px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    display: flex;
    flex-direction: column;
    background: #111;
  }
  .event--low { margin-top: 48px; }
  .event__media { position: relative; aspect-ratio: 1; }
  .event__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .chips {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    background: rgb(15 15 17 / 0.85);
    font-family: var(--font-dm-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: 6px;
  }
  .event__foot {
    position: relative;
    padding: 1.25rem 1.35rem 1.5rem;
    min-height: 150px;
  }
  .event__foot--red { background: var(--color-signal-red); }
  .event__foot--burgundy { background: var(--color-burgundy); }
  .meta {
    font-family: var(--font-dm-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.65rem;
  }
  .event h3 {
    font-family: var(--font-agrandir);
    font-size: 1.25rem;
    margin: 0;
    line-height: 1.2;
    max-width: 14ch;
    font-weight: 600;
  }
  .event__foot .arrow {
    position: absolute;
    right: 1.25rem;
    bottom: 1.15rem;
  }

  .journal {
    background: var(--color-sky);
    border-radius: 40px;
    padding: 2.5rem 2.5rem 2rem;
  }
  .journal .label-mono { margin: 0 0 0.5rem; }
  .journal h2 {
    font-family: var(--font-agrandir);
    font-weight: 600;
    font-size: clamp(36px, 5vw, 52px);
    margin: 0 0 2.5rem;
    line-height: 1;
  }
  .journal__row {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0 1rem 1rem;
    border-left: 1px solid rgb(0 0 0 / 0.25);
    border-bottom: 1px solid rgb(0 0 0 / 0.25);
    text-decoration: none;
    color: inherit;
  }
  .journal__badge {
    background: #fff;
    font-family: var(--font-dm-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .journal__date {
    font-family: var(--font-dm-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .intro, .programs-head, .guides, .events, .bento, .events__cards, .journal__row, .photos, .proof__row {
      display: flex;
      flex-direction: column;
    }
    .programs-head__aside { text-align: left; justify-self: start; }
    .a, .b, .c, .d, .e, .f { transform: none; min-height: 240px; }
    .guides { padding: 1.5rem; }
    .guides__media { margin: 0; }
    .guides__media > img:first-child { min-height: 280px; }
    .event--low { margin-top: 0; }
    .photos__a, .photos__b, .photos__c { height: 220px; }
    .hero-sticky {
      padding: calc(var(--hero-inset, 0) * 12px);
    }
  }
</style>

<script>
  function bindHeroFloat() {
    const pin = document.querySelector('[data-hero-pin]');
    const sticky = pin?.querySelector('.hero-sticky');
    if (!(pin instanceof HTMLElement) || !(sticky instanceof HTMLElement)) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const update = () => {
      const rect = pin.getBoundingClientRect();
      const range = Math.max(1, pin.offsetHeight - window.innerHeight);
      const scrolled = Math.min(range, Math.max(0, -rect.top));
      const progress = reduce ? 0 : Math.min(1, scrolled / range);
      sticky.style.setProperty('--hero-inset', String(progress));
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  bindHeroFloat();
  document.addEventListener('astro:page-load', bindHeroFloat);
</script>
