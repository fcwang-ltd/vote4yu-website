---
// The "Vote / for / Yu" hero lockup. The accent on "Yu" triggers the "You" reading.
// Copy is passed in per-locale; the Chinese hero tagline is a transcreation slot
// (the English pun does not carry phonetically) and ships DRAFT until native lock.
interface Props {
  tagline?: string;
  umbrella?: string;
  supporting?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  tagline = 'Vote for Yu, Vote for You',
  umbrella = 'Creating a HEALTH-y Markham',
  supporting = 'Dave Yu is a candidate for Markham City Council, Ward 2, in the 2026 municipal election.',
  ctaLabel = 'See the platform',
  ctaHref = '/platform',
} = Astro.props;
---

<section
  style="background: var(--color-deephero); color: var(--color-paper);"
  class="w-full"
>
  <div class="container-1200" style="padding-block: 96px;">
    <p
      style="font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent-light); font-size: 13px;"
    >
      Markham Ward 2 &middot; 2026
    </p>

    {/* Stacked Vote / for / Yu wordmark */}
    <h1 style="font-family: var(--font-display); line-height: 1.0; margin: 0.5rem 0;">
      <span style="display:block; font-size: clamp(48px, 9vw, 90px); font-weight: 800; color: var(--color-paper);">Vote</span>
      <span style="display:block; font-size: clamp(32px, 5vw, 56px); font-weight: 400; color: var(--color-muted);">for</span>
      <span style="display:block; font-size: clamp(48px, 9vw, 90px); font-weight: 800; color: var(--color-accent-light);">Yu</span>
    </h1>

    <p style="font-family: var(--font-display); font-size: clamp(20px, 3vw, 32px); font-weight: 600; margin-top: 1rem;">
      {umbrella}
    </p>
    <p style="max-width: 42ch; margin-top: 1rem; line-height: 1.7;">{supporting}</p>
    <p style="font-family: var(--font-mono); font-size: 12px; color: var(--color-muted); margin-top: 0.5rem;">
      {tagline}
    </p>

    <a
      href={ctaHref}
      style="display:inline-block; margin-top: 2rem; background: var(--color-accent); color: var(--color-paper); border-radius: var(--radius-xl); padding: 14px 28px; font-weight: 600; text-decoration: none;"
    >
      {ctaLabel}
    </a>
  </div>
</section>
