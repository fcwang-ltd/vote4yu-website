---
import LanguagePicker from './LanguagePicker.astro';
import { localizePath, type Locale } from '../../utils/i18n';
interface Props {
  locale: Locale;
  path?: string;
  navLabels: { platform: string; about: string; blog: string; contact: string };
}
const { locale, path = '/', navLabels } = Astro.props;
---

<header style="border-bottom: 1px solid var(--color-ink);">
  <div
    class="container-1200"
    style="display:flex; align-items:center; justify-content:space-between; padding-block: 15px; gap: 1rem; flex-wrap: wrap;"
  >
    <a href={localizePath('/', locale)} style="font-family: var(--font-display); font-weight: 800; text-decoration:none; color: var(--color-ink);">
      Vote<span style="color: var(--color-accent);">4</span>Yu
    </a>
    <nav style="display:flex; gap: 1.25rem; font-family: var(--font-body); flex-wrap: wrap;">
      <a href={localizePath('/platform', locale)} style="text-decoration:none; color: var(--color-ink);">{navLabels.platform}</a>
      <a href={localizePath('/about', locale)} style="text-decoration:none; color: var(--color-ink);">{navLabels.about}</a>
      <a href={localizePath('/blog', locale)} style="text-decoration:none; color: var(--color-ink);">{navLabels.blog}</a>
      <a href={localizePath('/contact', locale)} style="text-decoration:none; color: var(--color-ink);">{navLabels.contact}</a>
    </nav>
    <LanguagePicker current={locale} path={path} />
  </div>
</header>
