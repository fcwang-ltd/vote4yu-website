---
import { type Locale } from '../../utils/i18n';
interface Props {
  locale: Locale;
  boilerplate?: string;
}
const {
  locale,
  boilerplate = 'Dave Yu is the health-expert candidate for Markham Ward 2 councillor, creating a HEALTH-y Markham.',
} = Astro.props;
const year = new Date().getFullYear();
---

<footer style="background: var(--color-deephero); color: var(--color-paper); margin-top: 60px;">
  <div class="container-1200" style="padding-block: 48px;">
    <p style="max-width: 60ch; line-height: 1.7;">{boilerplate}</p>
    <p style="font-family: var(--font-mono); font-size: 12px; color: var(--color-muted); margin-top: 1.5rem;">
      &copy; {year} Vote4Yu &middot; Authorised campaign website &middot; Markham, Ontario, Canada
    </p>
  </div>
</footer>
