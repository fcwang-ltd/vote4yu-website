---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['cta-arrow', className]}
  width="14"
  height="14"
  viewBox="0 0 14 14"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M2.5 7h8.2M7.2 3.5 11 7l-3.8 3.5"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>

<style>
  .cta-arrow {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.1em;
  }
</style>
