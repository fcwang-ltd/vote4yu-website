---
import CommitForm from './CommitForm.astro';
import FormSubmitScript from './FormSubmitScript.astro';
import HealthCascade from './HealthCascade.astro';
import { getContent } from '../../utils/content';
import { localizePath, type Locale } from '../../utils/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = getContent(locale);

const heroPhotos = [
  {
    src: '/images/candidate/hero-images/yu-photo-white-1-transparent.png',
    fallback: '/images/candidate/yu-photo-white-1.png',
    alt: 'Haohui Yu 余浩輝',
  },
  {
    src: '/images/candidate/hero-images/yu-photo-white-2-transparent.png',
    fallback: '/images/candidate/yu-photo-white-2.png',
    alt: 'Haohui Yu 余浩輝',
  },
  {
    src: '/images/candidate/hero-images/yu-photo-white-3-transparent.png',
    fallback: '/images/candidate/yu-photo-white-3.png',
    alt: 'Haohui Yu 余浩輝',
  },
];
---

<FormSubmitScript />

<section class="hero">
  <img
    class="hero__watermark"
    src="/images/candidate/yu-brush-bw.svg"
    alt=""
    aria-hidden="true"
  />
  <div class="hero__inner container-1200">
    <div class="hero__form">
      <CommitForm locale={locale} variant="hero" />
    </div>

    <div class="hero__visual">
      <img
        class="hero__brush"
        src="/images/candidate/yu-brush-magenta.svg"
        alt=""
        aria-hidden="true"
      />
      <div class="hero__nameplate">
        <img
          class="hero__name"
          src="/images/candidate/yu-first-name.svg"
          alt="余浩輝 Haohui"
          width="320"
          height="140"
        />
      </div>
      <div class="hero__photos" data-hero-photos>
        {
          heroPhotos.map((photo, i) => (
            <img
              class:list={['hero__photo', { 'is-active': i === 0 }]}
              src={photo.src}
              data-fallback={photo.fallback}
              alt={i === 0 ? photo.alt : ''}
              width="640"
              height="800"
              data-hero-photo
              decoding="async"
              loading={i === 0 ? 'eager' : 'lazy'}
              aria-hidden={i === 0 ? 'false' : 'true'}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<div class="hero-join" data-ticker-dark>
  <div class="slant-stack">
    <div class="slogan-ribbon">
      <div class="slogan-ribbon__inner">
        <p>{t.home.slogan}</p>
      </div>
    </div>

    <div class="hero-to-blue">
      <div class="hero-to-blue__inner">
        <HealthCascade locale={locale} flush />

        <section class="band band--blue section-pad" id="how-to-vote">
          <div class="container-1200">
            <h2 class="band__title">{t.home.howToVoteTitle}</h2>
            <div class="vote-grid">
              {
                t.home.voteSteps.map((step) => (
                  <article class="vote-card">
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                    <a
                      class="btn btn--outline-white"
                      href={step.href}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {step.cta} →
                    </a>
                  </article>
                ))
              }
            </div>
            <p class="band__note">
              <a href="https://www.markham.ca" rel="noopener noreferrer" target="_blank"
                >{t.home.voteOfficial}</a
              >
            </p>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>

<section class="journey-short section-pad">
  <div class="container-1200">
    <div class="journey-short__head">
      <h2>{t.home.journeyTitle}</h2>
      <a href={localizePath('/about/journey', locale)}>{t.home.seeAllNews} →</a>
    </div>
    <div class="journey-short__grid">
      {
        t.progress.items.slice(0, 3).map((item) => (
          <article class="news-card">
            <time>{item.date}</time>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a href={localizePath('/about/journey', locale)}>{t.home.readFull} →</a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-hero-photos]');
    if (!root) return;
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-hero-photo]'));
    slides.forEach(function (img) {
      img.addEventListener('error', function onErr() {
        img.removeEventListener('error', onErr);
        var fb = img.getAttribute('data-fallback');
        if (fb && img.getAttribute('src') !== fb) {
          img.setAttribute('src', fb);
        }
      });
    });
    if (slides.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var i = 0;
    setInterval(function () {
      slides[i].classList.remove('is-active');
      slides[i].setAttribute('aria-hidden', 'true');
      slides[i].alt = '';
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
      slides[i].setAttribute('aria-hidden', 'false');
      slides[i].alt = 'Haohui Yu 余浩輝';
    }, 8000);
  })();
</script>

<style>
  /* One shared lift value: pink band height over the hero. */
  .hero,
  .hero-join {
    --ribbon-lift: 380px;
    --slant: calc(100vw * tan(15deg));
  }

  .hero {
    --ticker-h: 2.25rem;
    /* Full taupe (no transparent hole) so nothing white shows above the ribbon. */
    background: var(--color-taupe-100);
    position: relative;
    overflow: visible;
    margin-top: calc(-1 * var(--ticker-h));
    padding-top: var(--ticker-h);
    padding-bottom: 1rem;
  }
  .hero__watermark {
    position: absolute;
    left: 18%;
    top: -8%;
    width: min(95vw, 920px);
    opacity: 0.07;
    pointer-events: none;
    background: transparent;
    mix-blend-mode: multiply;
    z-index: 0;
  }
  .hero__inner {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.5rem calc(var(--ribbon-lift) + 0.5rem);
    align-items: start;
    position: relative;
  }
  .hero__form {
    position: relative;
    z-index: 3;
    order: 2;
    padding-bottom: 0.5rem;
  }
  .hero__visual {
    position: relative;
    min-height: 20rem;
    order: 1;
  }
  .hero__brush {
    position: absolute;
    left: 0;
    top: 10%;
    width: min(70%, 380px);
    height: auto;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    background: transparent;
    mix-blend-mode: multiply;
  }
  .hero__nameplate {
    position: absolute;
    left: 4%;
    top: 58%;
    z-index: 0;
    width: min(42%, 220px);
  }
  .hero__name {
    width: 100%;
    height: auto;
    display: block;
    background: transparent;
  }
  .hero__photos {
    position: relative;
    z-index: 3;
    width: min(82%, 480px);
    margin-left: auto;
    aspect-ratio: 640 / 800;
    min-height: 18rem;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom right;
    opacity: 0;
    transition: opacity 0.9s ease;
    pointer-events: none;
  }
  .hero__photo.is-active {
    opacity: 1;
  }

  /*
    Join over hero taupe (z1); photo/form at z3 above the ribbon.
    Upward clip-path keeps the right-side ribbon peak visible without a
    tall blue padding band; bottom edge stays square for Journey.
  */
  .hero-join {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * var(--ribbon-lift));
    background: var(--color-blue-600);
    padding-top: 0;
    clip-path: polygon(
      0 calc(var(--slant) * -1),
      100% calc(var(--slant) * -1),
      100% 100%,
      0 100%
    );
  }

  .slant-stack {
    transform: skewY(-15deg);
    transform-origin: center top;
    margin-top: 0;
    margin-bottom: calc(var(--slant) * -0.5);
  }

  .slogan-ribbon {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--color-paper);
    text-align: center;
    background: var(--color-pink-500);
  }
  .slogan-ribbon__inner {
    transform: skewY(15deg);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    padding: 1rem 1.5rem;
  }
  .slogan-ribbon p {
    margin: 0;
    font-family: var(--font-agrandir);
    font-weight: 700;
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    letter-spacing: 0.01em;
    line-height: 1.15;
    text-transform: none;
    font-style: normal;
    font-synthesis: none;
    transform: rotate(-15deg);
  }

  .hero-to-blue {
    position: relative;
    z-index: 2;
    background: var(--color-blue-600);
    padding-top: 1.25rem;
    padding-bottom: 0.5rem;
  }
  .hero-to-blue__inner {
    transform: skewY(15deg);
  }

  .band--blue {
    background: transparent;
    color: var(--color-paper);
  }
  .band__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0 0 1.5rem;
  }
  .vote-grid {
    display: grid;
    gap: 1.25rem;
  }
  .vote-card {
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 1.25rem;
  }
  .vote-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }
  .vote-card p {
    margin: 0 0 1rem;
    opacity: 0.95;
  }
  .band__note {
    margin-top: 1.5rem;
  }
  .band__note a {
    color: var(--color-pink-200);
  }
  .journey-short {
    background: var(--color-taupe-50);
    position: relative;
    z-index: 1;
  }
  .journey-short__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }
  .journey-short__head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .journey-short__head a {
    color: var(--color-pink-500);
    font-weight: 700;
    text-decoration: none;
  }
  .journey-short__grid {
    display: grid;
    gap: 1rem;
  }
  .news-card {
    background: var(--color-paper);
    padding: 1.25rem;
    border-top: 3px solid var(--color-pink-500);
  }
  .news-card time {
    font-size: 0.8rem;
    color: var(--color-ink-500);
  }
  .news-card h3 {
    margin: 0.35rem 0;
  }
  .news-card a {
    color: var(--color-pink-500);
    font-weight: 700;
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .hero {
      padding-bottom: 0.5rem;
    }
    .hero__inner {
      grid-template-columns: minmax(280px, 0.85fr) 1.3fr;
      align-items: start;
      min-height: calc(100vh - 6.5rem);
      padding-block: 1.25rem calc(var(--ribbon-lift) + 1.25rem);
      gap: 1rem 1.5rem;
    }
    .hero__form {
      order: 1;
      padding-top: clamp(2rem, 8vh, 5rem);
      padding-bottom: calc(var(--ribbon-lift) * 0.35);
    }
    .hero__visual {
      order: 2;
      min-height: 34rem;
      padding-bottom: 0;
    }
    .hero__brush {
      left: 2%;
      top: 8%;
      width: min(62%, 520px);
    }
    .hero__nameplate {
      left: 8%;
      top: 48%;
      width: min(38%, 260px);
    }
    .hero__photos {
      width: min(70%, 540px);
      min-height: 26rem;
    }
    .slogan-ribbon__inner {
      min-height: 3.75rem;
      padding: 1.1rem 1.5rem;
    }
    .hero-to-blue {
      padding-top: 1.75rem;
    }
    .vote-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .journey-short__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__photo {
      transition: none;
    }
  }
</style>
