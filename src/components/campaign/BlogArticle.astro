---
/*
 * The rendered body of a blog post.
 *
 * Shared by the public route (/blog/[slug]) and the unlisted preview route, so
 * a preview is a faithful preview — if this markup lived in two places the two
 * would drift and the preview would stop showing what readers will see.
 */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getContent, HEALTH_PLANKS } from '../../utils/content';
import { localizePath, type Locale } from '../../utils/i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  locale?: Locale;
}
const { post, locale = 'en' } = Astro.props;
const { Content } = await render(post);
const t = getContent(locale);

/* Categories are stored as HEALTH_PLANKS.labelEn strings; resolve each to its
   plank for the bilingual tag pill (matches the "為您發聲 Advocacy" pattern
   already used for the HEALTH cards). */
const tags = post.data.categories
  .map((label) => HEALTH_PLANKS.find((p) => p.labelEn === label))
  .filter((p): p is (typeof HEALTH_PLANKS)[number] => Boolean(p));
---

<article class="post section-pad">
  <div class="container-1200 post__col">
    <a class="post__back" href={localizePath('/blog', locale)}>‹ {t.events.postBack}</a>

    <h1 class="post__title">{post.data.title}</h1>
    <p class="post__meta">
      {t.events.postPostedOn}{' '}
      <time datetime={post.data.pubDate.toISOString()}>
        {
          /* pubDate is a date, not a moment: frontmatter "2026-09-05" parses as
             UTC midnight, so formatting it in the build machine's timezone
             renders the previous day west of Greenwich. Format in UTC. */
          post.data.pubDate.toLocaleDateString(locale === 'zh-HK' ? 'zh-Hant-HK' : 'en-CA', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          })
        }
      </time>
    </p>

    {
      tags.length > 0 && (
        <ul class="post__tags">
          {tags.map((tag) => (
            <li class="post__tag">
              <span class="post__tag-zh">{tag.labelZh}</span>
              <span class="post__tag-en">{tag.labelEn}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      post.data.heroImage && (
        <img class="post__hero" src={post.data.heroImage.src} alt={post.data.heroImage.alt} />
      )
    }

    <div class="post__body">
      <Content />
    </div>
  </div>
</article>

<style>
  .post__col {
    max-width: 42rem;
  }
  .post__back {
    display: inline-block;
    color: var(--color-pink-500);
    font-weight: 700;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }
  .post__back:hover,
  .post__back:focus-visible {
    text-decoration: underline;
  }
  .post__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
    margin: 0 0 0.5rem;
  }
  .post__meta {
    color: var(--color-ink-500);
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }
  .post__tag {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--color-blue-100);
  }
  .post__tag-zh {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-blue-700);
  }
  .post__tag-en {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-blue-700);
  }
  /* No forced aspect ratio: a hero is cropped by whoever chose it, and the
     page should show that crop rather than cut a second one out of it. */
  .post__hero {
    display: block;
    width: 100%;
    margin: 0 0 1.75rem;
    background: var(--color-taupe-100);
  }
  .post__body {
    line-height: 1.6;
    color: var(--color-ink-800);
  }
  .post__body :global(a) {
    color: var(--color-pink-500);
  }
  /* Photos in the body sit at the same width as the hero and each other. */
  .post__body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.75rem 0;
    background: var(--color-taupe-100);
  }
  .post__body :global(p:has(> img:only-child)) {
    margin: 0;
  }
</style>
