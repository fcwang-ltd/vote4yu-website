---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import VoteTicker from './VoteTicker.astro';
import type { Locale } from '../../utils/i18n';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  path: string;
  active?: string;
  /** Unlisted page: keep it out of search results and the locale alternates. */
  noindex?: boolean;
}
const { locale = 'en', title, description, path, active = '', noindex = false } = Astro.props;
---

<BaseLayout locale={locale} title={title} description={description} path={path} noindex={noindex}>
  <div class="site-chrome">
    <Nav locale={locale} active={active} />
  </div>
  <div class="site-ticker">
    <VoteTicker direction="ltr" />
  </div>
  <main>
    <slot />
  </main>
  <Footer locale={locale} />
</BaseLayout>

<script is:inline>
  (function () {
    var chrome = document.querySelector('.site-chrome');
    var band = document.querySelector('.site-ticker');
    if (!chrome || !band) return;
    var ticker = band.querySelector('.vote-ticker');
    if (!ticker) return;

    function updateTickerContrast() {
      var rect = ticker.getBoundingClientRect();
      var x = Math.round(window.innerWidth / 2);
      var y = Math.round((rect.top + rect.bottom) / 2);
      /* Sample what's under the transparent ticker (not the chrome or the band itself). */
      var prevChrome = chrome.style.pointerEvents;
      var prevBand = band.style.pointerEvents;
      chrome.style.pointerEvents = 'none';
      band.style.pointerEvents = 'none';
      var el = document.elementFromPoint(x, y);
      chrome.style.pointerEvents = prevChrome;
      band.style.pointerEvents = prevBand;
      var onDark = !!(el && el.closest('[data-ticker-dark]'));
      ticker.classList.toggle('vote-ticker--on-dark', onDark);
    }

    var ticking = false;
    function onScrollOrResize() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        updateTickerContrast();
      });
    }

    updateTickerContrast();
    window.addEventListener('scroll', onScrollOrResize, { passive: true });
    window.addEventListener('resize', onScrollOrResize);
  })();
</script>

<style is:global>
  .site-chrome {
    position: sticky;
    top: 0;
    z-index: 40;
  }
  /* Scrolls away with the page; only the nav above it stays pinned. */
  .site-ticker {
    position: relative;
    z-index: 30;
  }
  .site-ticker .vote-ticker {
    background: transparent;
  }
</style>
