---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import VoteTicker from './VoteTicker.astro';
import type { Locale } from '../../utils/i18n';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  path: string;
  active?: string;
}
const { locale = 'en', title, description, path, active = '' } = Astro.props;
---

<BaseLayout locale={locale} title={title} description={description} path={path}>
  <div class="site-chrome">
    <Nav locale={locale} active={active} />
    <VoteTicker direction="ltr" />
  </div>
  <main>
    <slot />
  </main>
  <Footer locale={locale} />
</BaseLayout>

<script is:inline>
  (function () {
    var chrome = document.querySelector('.site-chrome');
    if (!chrome) return;
    var ticker = chrome.querySelector('.vote-ticker');
    if (!ticker) return;

    function updateTickerContrast() {
      var band = ticker.getBoundingClientRect();
      var x = Math.round(window.innerWidth / 2);
      var y = Math.round((band.top + band.bottom) / 2);
      /* Sample what's under the transparent ticker (not the chrome itself). */
      var prev = chrome.style.pointerEvents;
      chrome.style.pointerEvents = 'none';
      var el = document.elementFromPoint(x, y);
      chrome.style.pointerEvents = prev;
      var onDark = !!(el && el.closest('[data-ticker-dark]'));
      ticker.classList.toggle('vote-ticker--on-dark', onDark);
    }

    var ticking = false;
    function onScrollOrResize() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        updateTickerContrast();
      });
    }

    updateTickerContrast();
    window.addEventListener('scroll', onScrollOrResize, { passive: true });
    window.addEventListener('resize', onScrollOrResize);
  })();
</script>

<style is:global>
  .site-chrome {
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .site-chrome .vote-ticker {
    background: transparent;
  }
</style>
