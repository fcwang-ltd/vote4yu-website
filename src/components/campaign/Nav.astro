---
import Wordmark from '../ui/Wordmark.astro';
import { getContent } from '../../utils/content';
import { localizePath, switchLocalePath, type Locale } from '../../utils/i18n';

interface Props {
  locale?: Locale;
  active?: string;
}
const { locale = 'en', active = '' } = Astro.props;
const t = getContent(locale);
const pathname = Astro.url.pathname;

const links = [
  { id: 'home', href: localizePath('/', locale), zh: t.nav.homeZh, en: t.nav.homeEn },
  { id: 'platform', href: localizePath('/platform', locale), zh: t.nav.platformZh, en: t.nav.platformEn },
  { id: 'about', href: localizePath('/about', locale), zh: t.nav.aboutZh, en: t.nav.aboutEn },
  { id: 'events', href: localizePath('/events', locale), zh: t.nav.eventsZh, en: t.nav.eventsEn },
  { id: 'involved', href: localizePath('/get-involved', locale), zh: t.nav.involvedZh, en: t.nav.involvedEn },
];

const enHref = switchLocalePath(pathname, 'en');
const zhHref = switchLocalePath(pathname, 'zh-HK');
---

<header class="site-header">
  <div class="site-header__inner container-1200">
    <Wordmark locale={locale} />

    <nav class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class:list={['site-nav__link', { 'is-active': active === link.id }]}
            href={link.href}
          >
            <span class="site-nav__zh">{link.zh}</span>
            <span class="site-nav__en">{link.en}</span>
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <div class="lang-pill" role="group" aria-label="Language">
        <a
          class:list={['lang-pill__btn', { 'is-active': locale === 'en' }]}
          href={enHref}
          data-lang="en"
          hreflang="en"
        >
          {t.nav.langEn}
        </a>
        <a
          class:list={['lang-pill__btn', { 'is-active': locale === 'zh-HK' }]}
          href={zhHref}
          data-lang="zh-HK"
          hreflang="zh-Hant"
        >
          {t.nav.langZh}
        </a>
      </div>
      <a class="btn btn--pink site-header__donate" href={localizePath('/donate', locale)}>
        {t.nav.donate}
      </a>
      <details class="site-menu">
        <summary class="site-menu__summary">{t.nav.menu}</summary>
        <div class="site-menu__panel">
          {
            links.map((link) => (
              <a href={link.href}>
                {link.zh} {link.en}
              </a>
            ))
          }
          <a href={localizePath('/donate', locale)}>{t.nav.donate}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const KEY = 'v4y-lang';
  document.querySelectorAll('[data-lang]').forEach((el) => {
    el.addEventListener('click', () => {
      const lang = el.getAttribute('data-lang');
      if (lang) {
        try {
          localStorage.setItem(KEY, lang);
        } catch {
          /* ignore */
        }
      }
    });
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 1;
    background: var(--color-paper);
    border-bottom: 0;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }
  .site-nav {
    display: none;
    flex: 1;
    justify-content: center;
    gap: 0.25rem;
  }
  .site-nav__link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 0.4rem 0.65rem;
    text-decoration: none;
    color: var(--color-ink-800);
    line-height: 1.15;
  }
  .site-nav__zh {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .site-nav__en {
    font-size: 0.7rem;
    color: var(--color-ink-500);
  }
  .site-nav__link.is-active,
  .site-nav__link.is-active .site-nav__en {
    color: var(--color-pink-500);
  }
  .site-header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .lang-pill {
    display: inline-flex;
    border: 1px solid var(--color-ink-800);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .lang-pill__btn {
    padding: 0.35rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-ink-800);
    background: var(--color-paper);
  }
  .lang-pill__btn.is-active {
    background: var(--color-blue-800);
    color: var(--color-paper);
  }
  .site-header__donate {
    display: none;
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
  }
  .site-menu {
    position: relative;
  }
  .site-menu__summary {
    list-style: none;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.4rem 0.6rem;
  }
  .site-menu__summary::-webkit-details-marker {
    display: none;
  }
  .site-menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    min-width: 14rem;
    background: var(--color-paper);
    border: 1px solid var(--color-taupe-200);
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    gap: 0.25rem;
  }
  .site-menu__panel a {
    padding: 0.55rem 0.7rem;
    text-decoration: none;
    color: var(--color-ink-800);
    font-weight: 600;
  }
  @media (min-width: 960px) {
    .site-nav {
      display: flex;
    }
    .site-header__donate {
      display: inline-flex;
    }
    .site-menu {
      display: none;
    }
  }
</style>
