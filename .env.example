# Copy this to `.env` locally (do not commit secrets).
# PUBLIC_FORMS_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
PUBLIC_FORMS_ENDPOINT=

# Homepage Commit form is hidden until GCP Apps Script forms are ready.
# Set to true to show the hero Commit form again.
PUBLIC_FORMS_ENABLED=false

# Passphrase for the unlisted protected page. Local dev only — in CI this is the
# PRIVATE_PAGE_PASSPHRASE Actions secret. Never commit a real value.
PRIVATE_PAGE_PASSPHRASE=

# Canvassing tool sync (Google Apps Script). Local dev only — in CI these are
# the CANVASS_SCRIPT_URL / CANVASS_TOKEN Actions secrets. Never commit real
# values: this repository is public.
CANVASS_SCRIPT_URL=
CANVASS_TOKEN=
